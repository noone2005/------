{"version":"1.1","saveTime":"2025-2-12 15:54:20","nodes":[{"title":"python程序基础","content":"","level":1,"expanded":true,"children":[{"title":"运算符1","content":"","level":2,"expanded":true,"children":[{"title":"算术运算符","content":"a = 20\r\nb = 10\r\nc = 0\r\n\r\n# 加法运算\r\nc = a + b\r\nprint(\"1--c的值为:\", c)\r\n\r\n# 减法运算\r\nc = a - b\r\nprint(\"2--c的值为:\", c)\r\n\r\n# 乘法运算\r\nc = a * b\r\nprint(\"3--c的值为:\", c)\r\n\r\n# 除法运算\r\nc = a \/ b\r\nprint(\"4--c的值为:\", c)\r\n\r\n# 取余运算\r\nc = a % b\r\nprint(\"5--c的值为:\", c)\r\n\r\n# 取整除运算\r\nc = a \/\/ b\r\nprint(\"6--c的值为:\", c)\r\n\r\n# 修改变量 a 、b 、c\r\na = 2\r\nb = 3\r\nc = a ** b  # 幂的运算\r\nprint(\"7--c的值为:\", c)\r\n","level":3,"expanded":false,"files":[{"filename":"算术运算符.py","filepath":"files\\20250212154916_2_算术运算符.py","note":"运算符","addtime":"2025-2-12 15:49:16"}]}],"files":[]},{"title":"运算符2","content":"","level":2,"expanded":false,"files":[]}],"files":[]}]}